// EXPECT: FAIL
// A value that doesn't match its declared Syntax is an error, so this fails
// the parse: the Parser counts every error reported to it, and the driver
// exits non-zero when there are any.
//
// What the exit code cannot assert, and this test still stands for: the
// mismatch reports *one* error and then recovers - skipping to the next ;/}
// and recording an empty value - rather than cascading into "can't find
// closing }" for every enclosing block. The single diagnostic and the absence
// of a cascade are confirmed by hand with ADL_DEBUG=1; asserting the tree it
// leaves behind needs the structural mode ../ToDo asks for.
TOP {
	Number:;
	Digits: Number {
		Syntax = /[1-9]*\d/
	}
	Bad: Digits = 'nope';			// Faulty: a quoted string doesn't match Digits' Syntax
}
