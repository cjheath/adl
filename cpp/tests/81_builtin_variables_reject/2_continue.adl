// Deliberately carries no EXPECT marker, for the same reason as
// 41_reference_reject.adl and its siblings: these are correctly rejected
// (see the printed "final restriction" diagnostics below), but like
// every other semantic check that isn't yet wired through to fail the
// parse, that's print-only and doesn't currently affect the exit code.
// Mark this test properly once errors are propagated through a proper
// ErrNum (see cpp/ToDo).
Foo: Object;

// Faulty: Foo's real parent is TOP, not Boolean - Parent behaves like a
// final assignment set once by the engine at creation time.
Foo {
	Parent = Boolean;
}

// Faulty: Boolean already finalised Is Sterile = True (adl.adl); a
// tentative or final re-assignment, even to the same subtype, is
// rejected - there's no narrowing exception for a non-Reference variable.
Boolean {
	Is Sterile = False;
}
