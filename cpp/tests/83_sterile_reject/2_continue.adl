// EXPECT: FAIL
// Rejected: Colour is sterile, so no new subtype of it may be created. The
// same failure is reported twice - once position-less from the object model,
// once positioned by the Sink - and the Parser counts each report, so a single
// rejected definition can count as more than one error.
Colour: Enumeration;
Red: Colour;
Colour { Is Sterile = True; }

// Faulty: Colour is now sterile, so Blue may not be added as a new
// subtype.
Blue: Colour;
