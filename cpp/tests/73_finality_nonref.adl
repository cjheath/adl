// EXPECT: PASS
// README "Tentative Assignment": "it's also possible that an assignment
// is tentative by defining it using the tentative assignment operator ~=.
// A tentative assignment may be re-assigned in a subtype" - this is the
// spec's own example (Baking Product/Bread Slicer/Discount), adapted to
// use a locally-declared Digits Syntax (the built-in Number type only
// exists in adl.adl, not in this engine's own bootstrap; see cpp/ToDo).
// Finality enforcement for *non*-Reference variables (Handle::
// check_final_violation(), adlmem.h) - previously only References were
// checked (see 40_reference_narrow.adl/41_reference_reject.adl) - see
// 74_finality_nonref_reject.adl for the corresponding rejection.
TOP {
	Digits: {
		Syntax = /\d/
	}
	Product: {
		Discount: Digits;
	}
	Baking Product: Product {
		Discount ~= 8;		// Tentative: may still be re-assigned
	}
	Bread Slicer: Baking Product {
		Discount = 9;		// Allowed: overriding a tentative assignment
	}
}
