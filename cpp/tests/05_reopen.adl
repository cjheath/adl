// EXPECT: PASS
// Re-opening, in the forms that work: a plain reopen of an object declared in
// the same block, and a *contextual* extension reached only by ascending from
// an inner scope. The cases that fail are separate tests, each with its own
// marker: 05_supertype_undefined_reject, 05_double_ascent_reject and
// 20_contextual_scope_reject.
TOP {
	a: {
		b: {
			c:;
		}

		// Reopen b.c and add d with contents:
		b.c.d: {		// New a.b.c.d
			f: b.c;		// Contains an f
			f1: c;			// Correctly succeeds: implicit ascent for a bare (dot-less)
					//           name searches each ancestor's own children as it
					//           climbs, and b's own child happens to be named "c" -
					//           the same object already on the ascent path. That
					//           coincidence doesn't make the find wrong (previously
					//           flagged here as a "wrong success"; it isn't - see
					//           tests/96_supertype_ascend_may_reach_own_ancestor_ok.adl
					//           and cpp/ToDo (a)(3)).
			g: b;		// Supertype ascends implicitly
			i: f;		// No ascend
		}

		b.c {			// Not contextual: "b" is a's own direct child, and
			k:;			// this is written directly within a's own block -
		}				// a true local reopen of a's own content.

		l: {			// New scope for extension
			m:;				// Something local
			b.c {		// Contextually extend c: "b" is found only by ascending
						// from l (not l's own child), so this reopen extends
						// c, scoped to l, rather than modifying the real a.b.c.
				o: k;	// k *is* correctly found (as c's own child, via the
						// extension's fallback to c) - this isn't a bug: being
						// contextually reopened doesn't hide c's own real content
						// from within its own reopened block, it only affects
						// what's visible from *outside* it.
			}
		}
	}
}
