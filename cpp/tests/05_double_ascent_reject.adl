// EXPECT: FAIL
// Explicit ascent walks up the *lexical* {} scopes, not the object tree
// - see tests/05_double_ascent_ok.adl for the twin case that succeeds by
// that rule. Three dots from "h1" (declared inside "b.c.d: {...}", itself
// written directly inside "a"'s block, itself directly inside TOP) cross
// two { boundaries, landing on TOP - not on "b" (a lexical level further
// than that dot count reaches). TOP has no child named "b" (only "a"),
// so this is correctly, and permanently, rejected: it's not that the
// search should have gone further, or stopped sooner - three dots
// names a specific lexical scope, TOP, and "b" genuinely isn't there.
TOP {
	a: {
		b: {
			c:;
		}
		b.c.d: {
			h1: ...b;	// Three dots reach TOP; TOP has no child "b"
		}
	}
}
