// EXPECT: FAIL
// A Syntax mismatch inside a reopened block is an error, so this fails.
//
// What it checks, and what the exit code cannot: the mismatch reports one error
// and recovers rather than cascading into "can't find closing }" for every
// enclosing block (../ToDo's Bugs item 8), so B's own assignment still lands
// right after it - confirmed by hand with ADL_DEBUG=1. run_tests.sh compares
// exit codes only, so the tree it recovers to is not asserted here.
TOP {
	Number:;
	Digits: Number {
		Syntax = /[1-9]*\d/
	}
	Wrapper: Object {
		A: Digits = 'nope';	// Faulty: a quoted string doesn't match Digits' Syntax
		B: Digits = 42;		// Must still parse correctly after the bad one
	}
}
