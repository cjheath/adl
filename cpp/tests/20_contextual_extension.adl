// EXPECT: PASS
// README "Contextual Extension": reopening something found only by
// ascending beyond the current scope, or only through inheritance, is
// always contextual (extends it, invisible outside the reopening
// context); a plain local reopen ("{...}", no ascent/inheritance needed)
// instead "make[s] the changes to the original object" - unless a
// trailing dot forces it contextual anyway. Writing an *explicit* leading
// dot is its own such force, too, whether or not it causes any real
// movement: the author's own dot is the signal, not a side effect of
// where the search happened to land (2026-09-27; ".a.b" below used to be
// the one case in this file demonstrating the opposite, which was wrong).
// This file's comments were originally written before that rule was
// pinned down precisely (see cpp/ToDo); updated here to match, once each
// case was actually checked against the implementation.
TOP {
	a: {
		b:
	}

	c: {
		a.b.d:;		// "a" is found by ascending from c, but this reaches
				// start_object() with an explicit supertype - only
				// a *plain* reopen (no supertype, just "{...}" or an
				// assignment) is currently made contextual. Known
				// gap: this still modifies the real a.b, visible
				// from everywhere, not just from c - see cpp/ToDo.

		.a {		// "a" is found by explicit single-dot ascent from c
			e:;	// (c's own parent, TOP, has a child "a") - reached
				// only by ascending, so this correctly contextually
				// extends a, scoped to c: e is only visible via
				// this extension, not on the real TOP.a.
		}
	}

	.a.b {
		f:;		// This IS contextual, same as ".a" above, even though
				// the leading dot's explicit ascent lands right back
				// on TOP itself (this statement's own enclosing
				// scope) with no real movement: writing the dot at
				// all is the author's own signal to treat this as
				// reaching outside the current object, not something
				// that depends on whether the search happened to
				// need to move. f lands on a real extension of the
				// real a.b, scoped to TOP - not on a.b itself.
				// (Corrected 2026-09-27 - this file previously
				// documented the opposite as intentional; it wasn't.)
	}
}
