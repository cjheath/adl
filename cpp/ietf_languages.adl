// The IETF language subtags, as an ADL enumeration: the languages a schema
// can name when it has to say which one a piece of text is worded in.
//
// Loaded between adl.adl and whatever schema refers to it - strpp/tools/
// mcs.adl today, whose Set and Message.Text both reference Languages.Language,
// so that schema will not parse without this one loaded first.
//
// TOP is re-opened to declare Languages as a child of TOP whatever context
// the file before it left behind, and closed again at the end, so that the
// file after it starts from TOP in turn.

TOP {
Languages: {
	Language: Enumeration {
		LangName: String;
	}
	af: Language { LangName = 'Afrikaans'; };
	am: Language { LangName = 'Amharic'; };
	ar: Language { LangName = 'Arabic'; };
	arn: Language { LangName = 'Mapudungun'; };
